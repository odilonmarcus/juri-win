<ContentDialog
    x:Class="ConselhoJuridicoIA.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configuração das IAs"
    PrimaryButtonText="Salvar"
    SecondaryButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="610" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="560" Spacing="18">
            <Border Background="#EEF4FA" CornerRadius="10" Padding="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="Privacidade" FontWeight="SemiBold" />
                    <TextBlock Text="As chamadas saem diretamente deste computador para OpenAI e Anthropic. O aplicativo não mantém banco de histórico das análises. As chaves são guardadas pelo Credential Locker do Windows. O tratamento de dados pelos provedores segue as políticas das respectivas APIs." TextWrapping="Wrap" Foreground="#475467" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="OpenAI" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="API Key" Foreground="#667085" />
                <PasswordBox x:Name="OpenAIKeyBox" PlaceholderText="Cole a chave ou deixe em branco para manter a já salva" />
                <TextBlock Text="Modelo" Foreground="#667085" />
                <TextBox x:Name="OpenAIModelBox" PlaceholderText="gpt-5.6-sol" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="TestOpenAIButton" Content="Testar conexão OpenAI" Click="TestOpenAI_Click" />
                    <TextBlock x:Name="OpenAITestStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="#E4E7EC" />

            <StackPanel Spacing="8">
                <TextBlock Text="Anthropic / Claude" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="API Key" Foreground="#667085" />
                <PasswordBox x:Name="AnthropicKeyBox" PlaceholderText="Cole a chave ou deixe em branco para manter a já salva" />
                <TextBlock Text="Modelo" Foreground="#667085" />
                <TextBox x:Name="AnthropicModelBox" PlaceholderText="claude-sonnet-5" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="TestAnthropicButton" Content="Testar conexão Anthropic" Click="TestAnthropic_Click" />
                    <TextBlock x:Name="AnthropicTestStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Dica: os nomes dos modelos são editáveis para que o aplicativo continue utilizável quando novos modelos forem lançados." TextWrapping="Wrap" Foreground="#667085" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
