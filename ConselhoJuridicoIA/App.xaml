<Application
    x:Class="ConselhoJuridicoIA.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F9" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E7EE" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#173B64" />
            <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EAF1F8" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#147D64" />
            <SolidColorBrush x:Key="WarningBrush" Color="#A15C00" />
            <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
